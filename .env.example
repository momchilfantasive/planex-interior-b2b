# Copy this file to `.env.local` for local development.
# In Vercel: Project Settings → Environment Variables.
# Add the same keys for Production, Preview and Development.

# --- Sanity (required for Studio and CMS-backed portfolio) ---
# Create a project at https://www.sanity.io/manage
# Project ID is shown on the project page.
NEXT_PUBLIC_SANITY_PROJECT_ID=jztklnus

# Dataset name. Use `production` unless you explicitly created another dataset.
NEXT_PUBLIC_SANITY_DATASET=production

# GROQ API version date. Keep this pinned; do not use `v1`.
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-06

# --- Sanity webhook (optional, recommended on Vercel) ---
# Used by POST /api/revalidate so published portfolio changes appear without waiting for ISR.
# 1. Generate a long random string and paste it here.
# 2. In Vercel, add SANITY_REVALIDATE_SECRET with the same value.
# 3. In Sanity Manage → API → Webhooks, create a webhook:
#    URL: https://YOUR-PRODUCTION-DOMAIN/api/revalidate
#    Dataset: production
#    Trigger on: Create, Update, Delete
#    Filter: _type == "portfolioProject"
#    Secret: the same value as SANITY_REVALIDATE_SECRET
#    HTTP method: POST
SANITY_REVALIDATE_SECRET=

# --- Sanity CORS origins (Manage → API → CORS origins, not an env var) ---
# Add these origins with "Allow credentials" enabled:
#   http://localhost:3000
#   https://YOUR-PRODUCTION-DOMAIN
#   https://YOUR-VERCEL-PROJECT.vercel.app
# Preview deployments use unique *.vercel.app URLs. Add a preview URL if Studio login fails there.
# Studio is embedded at /studio/ on the same origin, so the site origin must be allowed.

# --- Vercel notes ---
# NEXT_PUBLIC_* values are inlined into the client bundle. Redeploy after changing them.
# No Sanity write token is required for this first version: Studio users log in with a Sanity account,
# and /portfolio/ reads only published documents through the public API/CDN.
